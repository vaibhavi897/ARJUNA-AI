# ---------------------------------------------------------------------------
# Arjuna AI - backend environment
# Copy this file to backend/.env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection. Create the database first:
#   createdb arjuna_ai           (or)   CREATE DATABASE arjuna_ai;
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/arjuna_ai
DB_ECHO=false

# Auth. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend origins allowed by CORS (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Resume uploads.
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# Runtime.
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# OPTIONAL: external LLM providers. Gemini is required to start Interview Arena.
# Other readiness scoring remains deterministic unless its existing provider is configured.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# LLM_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# CareerVerse (all optional - the module runs from the seeded dataset without
# them). Keys stay in the backend; the browser never sees them.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=            # https://aistudio.google.com/
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-latest
# ONET_USERNAME=             # https://services.onetcenter.org/ (web services login)
# ONET_PASSWORD=
# BLS_API_KEY=               # https://www.bls.gov/developers/ (works keyless at low volume)
# ADZUNA_APP_ID=             # optional job-market data
# ADZUNA_APP_KEY=
# BRAVE_SEARCH_API_KEY=      # optional public web search for job and LinkedIn discovery

# ---------------------------------------------------------------------------
# Translation (optional). Lets the whole site be shown in Hindi and other Indian languages.
# Get a key from https://dashboard.sarvam.ai/ . The key stays in the backend only.
# ---------------------------------------------------------------------------
# SARVAM_API_KEY=
# SARVAM_TRANSLATE_MODEL=mayura:v1

# Narration (optional). The same SARVAM_API_KEY also reads career story text aloud.
# Leave these unset to accept the defaults; the narration control is hidden
# entirely when SARVAM_API_KEY is missing.
# Change the model and the speaker together — each model has its own voices:
#   bulbul:v3       shubh, aditya, ritu, ashutosh, priya, neha, rahul, ...
#   bulbul:v4-flash persona ids such as shubh_enhi_ads
# bulbul:v2 is deprecated and is rejected by the provider.
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh
# SARVAM_TTS_PACE=1.0
